# Supabase (productie)
# Klassieke namen óf Vercel Marketplace namen worden allebei ondersteund.
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_ANON_KEY=jouw-anon-key
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key
# Alternatief (Vercel Marketplace):
# SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_SECRET_KEY=...
# SUPABASE_JWT_SECRET=...

# E-mail
RESEND_API_KEY=jouw-resend-key
EMAIL_FROM=Fluweel Events <noreply@fluweelevents.nl>
SITE_URL=https://fluweelevents.nl

# Team (kommagescheiden e-mails voor toewijzing in de werkomgeving)
ADMIN_TEAM_EMAILS=admin@fluweelevents.nl

# Optioneel: alleen deze e-mails mogen inloggen. Leeg = elk Supabase Auth-account.
# ADMIN_ALLOWED_EMAILS=naam@fluweelevents.nl,tweede@fluweelevents.nl

# Werkomgeving
ADMIN_HOST=https://admin.fluweelevents.nl

# Optioneel: geheim voor POST /api/webhooks/typeform (header x-fluweel-webhook of ?secret=)
# TYPEFORM_WEBHOOK_SECRET=kies-een-lange-random-string

# Lokale fallback auth (alleen als Supabase Auth keys ontbreken)
ADMIN_EMAIL=admin@fluweelevents.nl
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
ADMIN_SESSION_SECRET=kies-een-lange-random-string

# Optioneel: Moneybird API (toekomstige sync)
# MONEYBIRD_API_TOKEN=
